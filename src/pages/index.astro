---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Kester's Portfolio" description="Full-stack developer portfolio showcasing modern web applications">
  <main>
    <!-- Hero Section -->
    <section class="py-20 md:py-32 lg:py-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-sm font-medium text-gray-500 mb-6 tracking-wider uppercase">
          Full-Stack Developer
        </p>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-semibold mb-8">
          <span class="text-gray-500">Building Modern</span>
          <br />
          <span class="text-black dark:text-white">Web Experiences</span>
        </h1>
        <p class="text-xl text-gray-500 max-w-3xl leading-relaxed">
          Portfolio showcase
        </p>
      </div>
    </section>
  </main>
</Layout>
